{
    "name": "johnnycharlesw-github/woofminer",
    "description": "Database management in a single PHP file.",
    "homepage": "https://www.github.com/johnnycharlesw/woofminer/wiki/",
    "keywords": [
        "database"
    ],
    "support": {
        "issues": "https://github.com/johnnycharlesw/woofminer/issues",
        "forum": "https://github.com/johnnycharlesw/woofminer/discussions",
        "source": "https://github.com/johnnycharlesw/woofminer/"
    },
    "authors": [
        {
            "name": "Jakub Vrána",
            "homepage": "https://www.vrana.cz/"
        },
        {
            "name": "John Charles Woods",
            "homepage": "https://github.com/johnnycharlesw"
        }
    ],
    "autoload": {
        "exclude-from-classmap": [
            "woofminer/drivers/",
            "plugins/drivers/"
        ],
        "classmap": [
            "plugins/"
        ]
    },
    "license": [
        "Apache-2.0",
        "GPL-2.0-only"
    ],
    "require": {
        "php": ">=7.4"
    },
    "scripts": {
        "check": [
            "phpcs",
            "phpstan analyse -c phpstan.neon"
        ]
    }
}
